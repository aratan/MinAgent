# OpenAI-compatible Chat Completions endpoint
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
OPENAI_API_KEY=llama.cpp
OPENAI_MODEL=llama.cpp
OPENAI_INPUT=text,image
OPENAI_CONTEXT_WINDOW=32768

# What happens to an image path you write in the conversation.
#   on_demand (default) - the path stays a path; the pixels only go into the
#                         context when the model calls view_image. A screenshot
#                         is ~1000 tokens, so this is most of the saving.
#   eager               - attach the pixels straight away, as before. Only if
#                         your model refuses to call a tool before it will look
#                         at anything.
# Only read when OPENAI_INPUT includes image.
IMAGE_INPUT_MODE=on_demand

# Seconds a single request may stay open. All three default to 420 (7 minutes).
OPENAI_TIMEOUT_SECONDS=420
MCP_TIMEOUT_SECONDS=420
TERMINAL_TIMEOUT_SECONDS=420

# Most tool-call rounds a single turn may run before stopping. Defaults to 64.
# MAX_TOOL_ROUNDS=64

# Inline characters kept for a tool result too large for the context window.
# The rest is archived under .minagent/tool-outputs/ and the model reads it
# back with recall_tool_output. Defaults to 12000.
# TOOL_PREVIEW_CHARS=12000

# Recent tool results kept verbatim in the transcript. Older ones become a
# retrievable stub before compaction runs. Defaults to 3.
# TOOL_RESULT_KEEP=3

# Whether consecutive read-only tools in one response may run at the same time.
# Writing tools, approval-gated tools and MCP tools are never batched.
# Defaults to on.
# PARALLEL_TOOLS=on

# Turns a loaded capability survives unused before its tools leave the prompt again.
# 0 keeps everything loaded for the whole conversation.
# Defaults to 2.
# CAPABILITY_IDLE_TURNS=2

# Share of the context window at which the governor starts giving things up
# (index summaries, memory hints, idle capabilities, old tool results) and the
# share at which it gives them back. The low mark must leave room below the
# high one, or the prompt would change shape on every turn.
# CONTEXT_HIGH_WATERMARK=75%
# CONTEXT_LOW_WATERMARK=55%

# GPU compute: local voice, video, and music generation.
#
# An 8 GB card cannot hold two heavy models at once, so this keeps the voice
# engines (Kokoro + whisper.cpp) resident for instant replies and serializes
# video and music jobs, offloading layers into system RAM. Heavy jobs are
# refused when free VRAM is too low, naming the process holding the memory.
COMPUTE_ENABLED=off

# The interpreter the backends run under, when it is not the one running
# MinAgent. Leave it unset to inherit the agent's own interpreter.
#
# It usually needs to be set on this machine, because the agent runs on Python
# 3.14 and the generation stack does not go there: Kokoro's `misaki` requires
# <3.13, and LTX-Video's tokenizer needs transformers 4.x. A dedicated 3.12
# environment is the working combination, so:
#
#     uv venv --python 3.12 .venv-compute
#     uv pip install --python .venv-compute/bin/python torch \
#         --index-url https://download.pytorch.org/whl/cu128
#     uv pip install --python .venv-compute/bin/python \
#         "transformers==4.49.0" sentencepiece protobuf diffusers accelerate \
#         imageio imageio-ffmpeg scipy soundfile "misaki[en]>=0.7.16" \
#         num2words loguru kokoro tiktoken huggingface_hub
#     uv pip install --python .venv-compute/bin/python \
#         "https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.8.0/en_core_web_sm-3.8.0-py3-none-any.whl"
#
# COMPUTE_PYTHON=/ruta/al/proyecto/.venv-compute/bin/python

# Total VRAM of the card, in MiB. Only used when nvidia-smi is unavailable;
# free VRAM is measured, not assumed. Defaults to 8188 (an RTX 4060 Laptop).
# COMPUTE_VRAM_TOTAL_MIB=8188

# A heavy job takes minutes on a laptop GPU. The job timeout must clear a full
# render, or a long clip gets killed halfway. Defaults to 1800.
# COMPUTE_JOB_TIMEOUT_SECONDS=1800

# Voice is interactive, so it gets a much shorter budget than a render.
# Defaults to 120.
# COMPUTE_VOICE_TIMEOUT_SECONDS=120

# Whether a heavy job may unload a resident Ollama model to free VRAM, and put
# it back afterwards.
#   off (default) - never touch it. A refused job instead names the process
#                   holding the memory, and you free it if you want to.
#   on            - unload the model before a job that does not fit, then
#                   reload it when the job finishes, however it finished. The
#                   session is only cold for as long as the render takes, and
#                   the next queued job waits for the reload to finish.
#                   Not the default because evicting a warm model is the user's
#                   call, even when it comes straight back.
# COMPUTE_UNLOAD_OLLAMA=off

# How many heavy jobs may wait for the card before new ones are refused. A
# render is minutes of GPU time, so an unbounded queue is a backlog nobody is
# waiting for. Defaults to 8.
# COMPUTE_QUEUE_LIMIT=8

# Use on/off for boolean settings.
OPENAI_SHOW_REASONING=off
SKILLS_ENABLED=off
MCP_ENABLED=off

# How MCP tool calls are approved: ask (default), auto, or off.
# `auto` runs every MCP call without asking. The call and its arguments are
# still printed first, so what ran stays visible. An MCP server runs with your
# own permissions, so `auto` means a server can act without a human in the loop.
MCP_APPROVAL_MODE=ask

# Long plans the agent writes and runs for itself, checkpointed per step in
# .minagent/flows.json. On by default: a flow adds a plan and a checkpoint, and
# every step still goes through the tool's own approval rules.
FLOWS_ENABLED=on
# How many steps run before the runner hands control back to the model. Control
# also comes back at every "decide" step, every failure, and every missing input.
# FLOW_BATCH_STEPS=8

# Persistent SQLite memory: recall what already worked and save what works.
MEMORY_ENABLED=off
# Defaults to .agents/memory/memoria.db in the project root.
# MEMORY_DB_PATH=.agents/memory/memoria.db
# Answer straight from a high-confidence memory instead of calling the model.
# MEMORY_DIRECT_ANSWER=on
# Ask the model whether a turn that looks like a discovery is worth keeping.
# Only turns that failed repeatedly and then worked, or that took many steps,
# are ever put to it. on by default.
# MEMORY_EUREKA=on
# Turns between reviews of the automatically captured log. A review decides
# which entries are worth keeping and forgets the rest. 0 is not accepted;
# set MEMORY_EUREKA=off to judge turns without reviewing the log.
# MEMORY_REFLECTION_INTERVAL=10
# Compare memories by meaning as well as by wording, with an embedding model
# from your Ollama (`ollama pull nomic-embed-text`). It is asked only about
# stored memories that share a distinctive word with the new one, once per
# session per text, so a save costs one fast request at worst. Calibrated on a
# Spanish store: a restatement of a stored memory scores 0.89 to 0.96 and two
# different memories 0.52 to 0.79, and the check only ever adds a merge - below
# that line the word comparison decides, so nothing is lost when the model is
# not there. Empty means off, and the store then needs no model at all.
# MEMORY_EMBED_MODEL=nomic-embed-text

# Reflect on what a session teaches and turn it into improvements.
# IMPROVEMENT_ENABLED=on
# Let a hypothesis move a setting on its own. On by default because the
# surface it reaches is four numbers, each with a minimum, a maximum and a
# 24h cooldown, and because an agent that can only say "I should tighten this"
# is a suggestion nobody reads. Source code is never in that set.
#
# A change is applied on probation: a baseline is taken, and after a window
# of real turns it is kept or reverted on its own, by whether failures per
# turn or tool-result tokens per turn actually improved by at least 5% with
# the other not getting worse. The trial is in .minagent/prueba.json and
# /mejoras shows what is being measured.
# IMPROVEMENT_AUTO=on
# Memory reviews between reflections. Each pass is one model call.
# IMPROVEMENT_INTERVAL=10
# Run the reflection on a different model of the same endpoint. Empty uses the
# one answering the conversation. Naming another one is not free: on a card
# where the two do not fit together the session model is unloaded for the pass
# and loaded back afterwards, and the reflection has to be worth that. Measured
# on the prompt a real session sends, `gemma4:12b-q3km` never answered in the
# requested shape where the 9B did three times out of three, so this stays empty
# by default. Whatever the model, an answer that is not the requested shape is
# asked again on the session model before the pass is given up on.
# IMPROVEMENT_MODEL=

# Web search and fetch through Ollama's hosted API (needs an account key).
WEB_SEARCH_ENABLED=off
# OLLAMA_API_KEY=your_ollama_key
# WEB_SEARCH_BASE_URL=https://ollama.com/api
# WEB_SEARCH_TIMEOUT_SECONDS=120

# Read workspace images with a local multimodal model over Ollama's /api/chat.
# Any model whose `ollama list` entry shows the "vision" capability works.
# The image is base64-encoded into the request; nothing is uploaded.
VISION_ENABLED=off
# VISION_MODEL=qwen3.5:9b-q4_K_M
# VISION_BASE_URL=http://localhost:11434
# A 27B vision model on a laptop GPU takes minutes, so the default is generous.
# VISION_TIMEOUT_SECONDS=300

# 0 disables recursive inventory and @ file autocomplete; positive values limit each directory, -1 includes all entries.
WORKSPACE_LIST_LIMIT=0

# auto, ask, or off.
TERMINAL_MODE=off

# Keyboard and mouse control. Off by default: on this machine it can move the
# real pointer and press real keys, so it is your call whether the agent may.
# Needs the uinput path, which is why pyautogui cannot be used here - this is a
# Wayland session and pyautogui only speaks X11. Install once with:
#   sudo pacman -S ydotool
#   systemctl --user enable --now ydotoold
INPUT_ENABLED=off

# Camera and microphone, both captured on request rather than continuously.
# Nothing is recorded until a tool is called, and audio is transcribed by the
# local model in compute/ and never leaves the machine.
SENSES_ENABLED=off
# The camera to read. Check with: ls /dev/video*
# CAMERA_DEVICE=/dev/video0
# How many frames one call may grab, which bounds the wait.
# CAMERA_MAX_FRAMES=8
# Empty means the system default source. List them with: pactl list short sources
# MICROPHONE_DEVICE=
# MICROPHONE_MAX_SECONDS=30

# Managing the models this local Ollama serves: listing them, reading one in
# detail, creating a derived model with its own system prompt, and deleting one.
# OLLAMA_MODELS_ENABLED=off
# OLLAMA_MODELS_BASE_URL=http://localhost:11434
# OLLAMA_MODELS_TIMEOUT_SECONDS=300

# Writing new capability modules the agent can load, either kept in
# .minagent/subagents/ or thrown away when the session ends.
# Subagents work on a git branch, so a change is a diff you can read and revert.
# SUBAGENTS_ENABLED=off
# SUBAGENTS_DIRECTORY=.minagent/subagents
# How many throwaway modules may exist at once before old ones are dropped.
# SUBAGENTS_MAX_EPHEMERAL=4

# Publishing a model to a registry. This is the only setting here that sends
# anything off this machine, so it is separate from OLLAMA_MODELS_ENABLED and
# off by default. A push to a name with no host publishes to ollama.com, which
# cannot be undone, so the user has to type the model's full name to confirm it.
# OLLAMA_PUSH_ENABLED=off
