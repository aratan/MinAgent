.env
.env.*
!.env.example

# Local MCP configuration may contain commands, paths, headers, or credentials.
.minagent/mcp.json

# Local knowledge memory database and its write-ahead log.
.minagent/memory.db
.minagent/memory.db-*
.agents/memory/*.db
.agents/memory/*.db-*

# Oversized tool results archived outside the context window, so recall works.
.minagent/tool-outputs/

# Python / uv
.venv/
# The generation backends run on their own Python 3.12: Kokoro's misaki
# needs <3.13 and LTX-Video's tokenizer needs transformers 4.x.
.venv-compute/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
build/
dist/

# Dependencies of the local MCP servers in .agents/mcp/
node_modules/

# Scratch left in the workspace root by tooling, not part of the project.
# `None` is a saved page from a fetch that was handed a null URL.
/None
/config.json
/mcp_server.md
# A generated status report, named after the workspace. Listed by its exact name
# rather than as /README_*.md, which would also swallow a translated readme.
/README_workspace.md
.atl/

# Screen captures written by the captura-pantalla skill, not part of the project.
/capturas/

# Generated media and downloads: what the agent produces, not the project.
/salida/
/output/

# Scratch scripts and one-off probes written while working.
/workspace/
/historial_capturas.txt

# Capability modules the agent wrote and has not been asked to keep durable.
/.minagent/subagents/

# Snapshots, console logs and screenshots the Playwright MCP server writes.
/.playwright-mcp/

*.log
.DS_Store
Thumbs.db
